{
  "expo": {
    "name": "Saksham",
    "slug": "Saksham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saksham",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F6FC",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Saksham needs the microphone so you can speak your skill in your own language."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1462C6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1462C6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": { "backgroundColor": "#0B1120", "image": "./assets/images/splash-icon.png" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
