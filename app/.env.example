# Backend API base URL.
# - Simulator / emulator: http://localhost:4000 works (leave unset).
# - Physical device via Expo Go: set your laptop's LAN IP so the phone can reach it.
# - Deployed backend: set the public URL.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Sarvam Speech-to-Text API key for in-app transcription.
# For production, proxy this through your backend instead of shipping the key in the app bundle.
EXPO_PUBLIC_SARVAM_API_KEY=your_sarvam_api_key_here
