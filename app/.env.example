# Backend API base URL.
#
# LEAVE THIS UNSET unless you are working on the server. With no value the app
# talks to the deployed backend (https://saksham-api-82mn.onrender.com), so a
# fresh clone works straight away and everyone sees the same data.
#
# Override only when you need to:
#   http://localhost:4000  — a server on this machine (simulator/emulator, or web)
#   lan                    — a server on this machine, reached from a physical
#                            phone over Wi-Fi; the LAN IP is resolved for you
#   https://…              — any other deployment
# EXPO_PUBLIC_API_URL=

# Sarvam Speech-to-Text API key for in-app transcription.
# For production, proxy this through your backend instead of shipping the key in the app bundle.
EXPO_PUBLIC_SARVAM_API_KEY=
