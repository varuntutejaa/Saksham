# Copy to .env.local. URL of the Saksham backend API.
NEXT_PUBLIC_API_URL=https://saksham-api-82mn.onrender.com

# Optional — enables ElevenLabs voices for spoken replies in English, Hindi
# and Tamil (the languages ElevenLabs' multilingual model documents real
# support for). Without this set, every language falls back to the
# browser's own speech synthesis. Server-side only — never exposed to the
# client. Get a key at https://elevenlabs.io/app/settings/api-keys.
ELEVENLABS_API_KEY=
# Optional — defaults to the premade "Sarah" voice if unset.
ELEVENLABS_VOICE_ID=
