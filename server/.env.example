# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saksham?schema=public"

# JWT signing secret
JWT_SECRET="change-me-in-production"

# Server port
PORT=4000

# Optional: external AI provider keys
# ANTHROPIC_API_KEY=
# SARVAM_API_KEY=   # speech-to-text for all 10 languages
# GROQ_API_KEY=     # Whisper speech-to-text + LLM-first skill understanding
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=

# Optional: Twilio, for the WhatsApp webhook at POST /api/whatsapp/webhook
# (routes/whatsapp.ts). Point a Twilio WhatsApp sender's webhook URL at that
# endpoint once these are set — see the TODOs in that file for what's still
# needed before going live (signature validation, language/location context).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=   # e.g. whatsapp:+14155238886

# Optional: Google Stitch UI design generation (https://stitch.withgoogle.com/)
# STITCH_API_KEY=       # may work for some Stitch operations; OAuth is preferred for generation
# STITCH_ACCESS_TOKEN=  # OAuth token from gcloud auth print-access-token
# GOOGLE_CLOUD_PROJECT= # required when using STITCH_ACCESS_TOKEN
# STITCH_PROJECT_ID=   # optional default project for POST /api/stitch/screens
# STITCH_HOST=         # optional override for the Stitch MCP server URL
