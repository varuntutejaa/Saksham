# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saksham?schema=public"

# JWT signing secret
JWT_SECRET="change-me-in-production"

# Server port
PORT=4000

# Optional: external AI provider keys (falls back to built-in mock engine if unset)
# ANTHROPIC_API_KEY=
# SARVAM_API_KEY=   # primary speech-to-text for all 10 languages
# GROQ_API_KEY=     # Whisper STT fallback, used only if a configured Sarvam call fails
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=

# Optional: Twilio, for the WhatsApp webhook at POST /api/whatsapp/webhook
# (routes/whatsapp.ts). Point a Twilio WhatsApp sender's webhook URL at that
# endpoint once these are set — see the TODOs in that file for what's still
# needed before going live (signature validation, language/location context).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=   # e.g. whatsapp:+14155238886
