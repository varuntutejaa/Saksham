// Saksham — AI-Driven Voice Assistant for Livelihood Mapping and
// NSQF-Aligned Skilling Recommendations for SC Communities under PM-AJAY

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BENEFICIARY
  ADMIN
}

enum Language {
  hi // Hindi
  en // English
  bn // Bengali
  ta // Tamil
  te // Telugu
  mr // Marathi
  kn // Kannada
  gu // Gujarati
  pa // Punjabi
  or // Odia
}

enum SessionChannel {
  APP
  WEB
  IVR
  WHATSAPP
}

enum RecommendationStatus {
  SUGGESTED
  VIEWED
  INTERESTED
  APPLIED
  ENROLLED
  REJECTED
}

enum JobSource {
  NCS // fetched from National Career Service (ncs.gov.in) — not yet wired up, see Job.sourceUrl
  MANUAL // entered directly by a programme admin
}

model User {
  id            String   @id @default(cuid())
  phone         String?  @unique
  name          String?
  avatarUrl     String?  @db.Text // base64 data URI or hosted URL; null = no photo set
  passwordHash  String?
  role          Role     @default(BENEFICIARY)
  language      Language @default(hi)
  gender        String?
  age           Int?
  education     String? // below_10th | 10th | 12th | iti_diploma | undergrad | postgrad — self-declared
  onboarded     Boolean  @default(false) // has completed the post-signup profile questions
  category      String? // SC / ST / OBC / GEN — self-declared
  state         String?
  district      String?
  pincode       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        VoiceSession[]
  recommendations Recommendation[]
}

/// One conversation with the voice assistant.
model VoiceSession {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel        SessionChannel @default(APP)
  language       Language       @default(hi)
  rawTranscript  String? // what the beneficiary said (STT output)
  detectedSkills String[] // free-text skills extracted from the transcript
  bandwidthKbps  Int? // measured client bandwidth, for low-bandwidth analytics
  state          String?
  district       String?
  createdAt      DateTime       @default(now())

  mappings        SkillMapping[]
  recommendations Recommendation[]
}

/// NSQF-aligned qualification (National Skills Qualification Framework).
model NsqfQualification {
  id           String  @id @default(cuid())
  qpCode       String  @unique // e.g. "AGR/Q0101"
  title        String
  titleHindi   String?
  sector       String // e.g. "Agriculture", "Handicrafts & Carpet"
  nsqfLevel    Int // 1–10
  ssc          String? // Sector Skill Council / awarding body
  description  String?
  keywords     String[] // informal-skill keywords that map to this QP
  notionalHours Int? // training duration per NQR, when known
  nqrId        Int? @unique // nqr.gov.in qualification id, for traceability back to the source page

  /// Everything below is scraped verbatim from this qualification's own NQR
  /// detail page — nqr.gov.in/qualifications/<nqrId>, the same URL `qpCode`
  /// came from. See scripts/scrape-nsqf-details.ts; re-runnable any time.
  eligibility         Json? // [{ criteria1, criteria2, experience, trainingQualification }] — entry requirements
  minEducation        String? // lowest entry bar across the eligibility rows, denormalized so it can be filtered on
  progressionPathway  String[] // vertical / horizontal / academic next steps
  nos                 Json? // [{ title, code, mandatory, hours, credits, level }] — the syllabus
  nsqcNumber          String?
  approvedOn          DateTime?
  validTill           DateTime?
  /// true when validTill has passed. NQR qualifications genuinely expire, so
  /// the voice pipeline and catalogue both exclude these by default.
  expired             Boolean @default(false)
  notionalHoursMin    Int?
  notionalHoursMax    Int?
  theoryHours         Int?
  practicalHours      Int?
  employabilityHours  Int?
  ojtHours            String?
  awardingBodies      String[]
  organisationType    String?
  certifyingBodies    String[]
  /// job titles this qualification leads to, e.g. "Field Worker" — a much
  /// richer source of informal role names than the qualification title alone
  proposedOccupations String[]
  qualificationType   String?
  applicability       String? // STT | RPL | ...
  detailsScrapedAt    DateTime?

  mappings         SkillMapping[]
  trainingPrograms TrainingProgram[]
  jobRequirements  JobRequirement[]
}

/// A course/QP code actually eligible for PM-AJAY skilling funding, scraped
/// verbatim from the official course catalogue at pmajay.dosje.gov.in/CourseList
/// (see prisma/data/README-pmajay-courses.md for provenance). This is a
/// separate, real list from NsqfQualification — the two overlap conceptually
/// (same trades) but rarely share the same QP code, since PM-AJAY's list uses
/// newer course-code versions.
model PmajayCourse {
  id            String   @id @default(cuid())
  srNo          Int // row number on the source page, not a stable id
  courseLevel   String // "National" | "State [ODISHA]" | "State [PUNJAB]"
  sector        String
  subSector     String
  courseName    String
  subCourseCode String // the QP-style code shown on the source page — NOT guaranteed unique (~170 codes repeat across rows)
  subCourseName String
  keywords      String[] // informal-skill keywords that map to this course, same convention as NsqfQualification.keywords

  recommendations Recommendation[]
}

/// One retrievable passage of a real government policy document, for the
/// RAG-based /api/assistant/ask endpoint — answers policy/FAQ questions
/// ("will I get a certificate?", "how do I apply?") that the structured
/// tables above can't, because the answer lives in prose guidelines, not a
/// database row. See prisma/data/README-knowledge-base.md for provenance and
/// scripts/ingest-documents.ts for how these are produced (re-run any time
/// the source PDFs change). Retrieved via Postgres full-text search
/// (services/knowledge.ts) — no vector DB or embeddings API needed at this
/// corpus size (177 chunks).
model KnowledgeChunk {
  id            String @id @default(cuid())
  documentTitle String
  sourceUrl     String
  page          Int
  chunkIndex    Int
  text          String
}

/// Result of mapping an informal skill phrase to an NSQF qualification.
model SkillMapping {
  id                 String            @id @default(cuid())
  sessionId          String
  session            VoiceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawSkillText       String // "main mitti ke bartan banata hoon"
  normalizedSkill    String // "pottery"
  nsqfQualificationId String?
  nsqfQualification  NsqfQualification? @relation(fields: [nsqfQualificationId], references: [id], onDelete: SetNull)
  confidence         Float             @default(0) // 0–1
  method             String            @default("keyword") // keyword | embedding | llm | manual
  pmajayVerified     Boolean           @default(false) // true if this normalizedSkill also has a real PM-AJAY-eligible course (PmajayCourse)
  createdAt          DateTime          @default(now())
}

/// A PM-AJAY / partner skilling programme a beneficiary can be routed to.
///
/// NOTE ON DATA REALNESS: the current seed rows here are illustrative sample
/// data, not scraped from a government source — no central PM-AJAY source
/// publishes scheduled-batch data (seats, contact number, exact dates) at
/// this granularity; that's handled at the state/district implementing-
/// agency level. This is unlike NsqfQualification and PmajayCourse, which are
/// both real, scraped, traceable data (see prisma/data/README*.md). If real
/// programme data ever becomes available, replace these rows — the shape of
/// this model is already correct.
model TrainingProgram {
  id                  String             @id @default(cuid())
  name                String
  nameHindi           String?
  scheme              String             @default("PM-AJAY") // PM-AJAY component / partner scheme
  component           String? // "Adarsh Gram" | "GIA" | "Hostel" | "Skill Development"
  providerName        String?
  nsqfQualificationId String?
  nsqfQualification   NsqfQualification? @relation(fields: [nsqfQualificationId], references: [id], onDelete: SetNull)
  sector              String?
  nsqfLevel           Int?
  mode                String             @default("OFFLINE") // OFFLINE | ONLINE | HYBRID
  durationWeeks       Int?
  stipend             Boolean            @default(false)
  certification       String?
  state               String?
  district            String?
  address             String?
  contactPhone        String?
  seatsTotal          Int?
  seatsAvailable      Int?
  eligibilityNote     String?
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  recommendations Recommendation[]
}

/// A programme recommended to a specific beneficiary in a session.
model Recommendation {
  id                String               @id @default(cuid())
  sessionId         String
  session           VoiceSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// What was recommended. The voice pipeline recommends real PM-AJAY courses
  /// (`pmajayCourseId`); `trainingProgramId` is kept for the illustrative
  /// TrainingProgram rows the admin dashboard still manages. Exactly one is set.
  pmajayCourseId    String?
  pmajayCourse      PmajayCourse?        @relation(fields: [pmajayCourseId], references: [id], onDelete: SetNull)
  trainingProgramId String?
  trainingProgram   TrainingProgram?     @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  score             Float                @default(0)
  rationale         String? // human-readable "why this" in the user's language
  status            RecommendationStatus @default(SUGGESTED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

/// A real job role a beneficiary can become eligible for by holding certain
/// NSQF qualifications. Admin-managed for now (source = MANUAL); `sourceUrl`
/// and `source = NCS` are reserved for a future National Career Service feed
/// — ncs.gov.in has no public API today, so nothing fetches automatically yet.
model Job {
  id          String    @id @default(cuid())
  title       String
  titleHindi  String?
  sector      String?
  description String?
  source      JobSource @default(MANUAL)
  sourceUrl   String? // NCS listing URL, when source = NCS
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requirements JobRequirement[]
}

/// One NSQF qualification required for a Job. A beneficiary is "eligible"
/// for a job once their SkillMapping history covers every requirement row;
/// missing rows are surfaced as "complete these to become eligible".
model JobRequirement {
  id                  String            @id @default(cuid())
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nsqfQualificationId String
  nsqfQualification   NsqfQualification @relation(fields: [nsqfQualificationId], references: [id], onDelete: Cascade)

  @@unique([jobId, nsqfQualificationId])
}
